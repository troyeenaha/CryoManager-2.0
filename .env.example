# Copy this file to .env.local for local development.
# On Vercel, add the same two variables under Project → Settings → Environment Variables.
#
# Both values come from Supabase → Project Settings → API.
# The "anon / publishable" key is DESIGNED to be public: the database's
# Row Level Security rules decide what it can do.
#
# NEVER put the service_role / secret key, or the database password, here
# or anywhere in this repository.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
